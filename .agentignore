# .agentignore — fpmedia-web
#
# Tells AI agents which paths to skip when reading or indexing the project.
# Syntax mirrors .gitignore (glob patterns, leading / = repo root).
#

# Build output
/target/

# Generated lock files (too large, not useful to read)
Cargo.lock
package-lock.json

# Third-party packages
**/node_modules/

# Binary / media assets (tracked `fixture_*.mp4` still skipped for indexing)
public/
**/fixture_*.mp4
engine/tests/fixtures/*.mp4

# Large e2e baseline JSON (keep e2e/baselines/**/README.md)
e2e/baselines/**/*.json

# Rust editor artefacts
**/*.rs.bk
