# Generated by Cargo
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# Cursor history files
*.txt

# Generated by cargo mutants
**/mutants.out*/

# Node / local tooling
node_modules/
playwright-report/
test-results/
blob-report/
playwright/.cache/
e2e/.cache/
e2e/stress-reports/
e2e/stress-reports-*/

# Ad-hoc e2e / probe dumps (Tee-Object). Tracked baselines stay under e2e/baselines/.
*.log

# Editor
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Local / large media — never commit camera dumps or long clips.
# Only tiny fixtures under media/tests/fixtures/ stay trackable.
*.mp4
*.mov
*.webm
*.mkv
*.m4v
*.avi
!media/tests/fixtures/
!media/tests/fixtures/**
# Optional local fMP4 (see fixtures README) — still ignore even under fixtures/
media/tests/fixtures/fragmented_tiny.mp4
